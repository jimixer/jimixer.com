# 資格情報はここに書かない。
#
# AWS の資格情報は IAM Identity Center の短命なもので、恒久的なアクセスキーは無い
# （docs/aws-credentials.md）。プロファイルの指定はリポジトリ直下の .envrc が持ち、
# `direnv exec . npm run dev:gallery` で起動すれば SDK に渡る。
# ここに AWS_PROFILE を書いても direnv 経由の値が優先されるため効かない。効くのは
# direnv を通していないときだけで、素の 403 の原因を分かりにくくする（src/lib/s3.ts）。

# sidecar の置き場所。既定は ../website/content
# GALLERY_CONTENT_DIR=

# 派生物の公開先。既定は gallery.jimixer.com
# S3_BUCKET=

# 原本の保管先（非公開）。既定は jimixer-com-originals
# ORIGINALS_BUCKET=

# 既定は ap-northeast-1
# AWS_REGION=

# UI で画像を表示する URL の起点
NEXT_PUBLIC_GALLERY_URL=https://gallery.jimixer.com
